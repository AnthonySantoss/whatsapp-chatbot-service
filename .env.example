# Servidor do Bot
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Conector Primary Point (Nassau Espaços)
# Em ambiente Docker: http://agendador-dev-api-1:3000/api/v1/integrations/whatsapp
# Em desenvolvimento local fora do Docker: http://localhost:3000/api/v1/integrations/whatsapp
PRIMARY_POINT_API_URL=http://agendador-dev-api-1:3000/api/v1/integrations/whatsapp
PRIMARY_POINT_SERVICE_TOKEN=local-dev-bot-token-2026

# Evolution API v2
# Em ambiente Docker: http://evolution-api:8086
# Em desenvolvimento local fora do Docker: http://localhost:8086
EVOLUTION_API_URL=http://evolution-api:8086
EVOLUTION_API_KEY=evolution-local-secret-2026
EVOLUTION_INSTANCE_NAME=nassau-bot
